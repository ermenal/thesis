    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Trustzone",
            "cwd": "${workspaceFolder}",
            // "executable": "${workspaceFolder}/sharing/artifact/sharing-combined.s37",
            "executable": "${workspaceFolder}/production_image.hex",
            "request": "launch",
            "type": "cortex-debug",
            // "runToEntryPoint": "main",
            "servertype": "jlink",
            "device": "EFR32FG23B010F512IM48",
            // "boardId": "440330966",
            "symbolFiles": [
                {
                    "file": "${workspaceFolder}/sharing/sharing_s/build/debug/sharing_s.out",
                },
                {
                    "file": "${workspaceFolder}/sharing/sharing_ns/build/debug/sharing_ns.out",
                },
            ],
            "postLaunchCommands": [
                "add-symbol-file ${workspaceFolder}/empty/build/debug/empty.out 0x08000000",
                "source .vscode/tz_faults.gdb"
            ]
        },
        {
            "name": "Debug empty",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/empty/build/debug/empty.s37",
            "request": "launch",
            "type": "cortex-debug",
            // "runToEntryPoint": "main",
            "servertype": "jlink",
            "device": "EFR32FG23B010F512IM48",
            "symbolFiles": [
                {
                    "file": "${workspaceFolder}/empty/build/debug/empty.out",
                }
            ],
            "postLaunchCommands": [
                "source .vscode/tz_faults.gdb"
            ]
        }
    ]
}